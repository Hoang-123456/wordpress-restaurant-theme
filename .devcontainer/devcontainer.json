{
  "name": "Restaurant WordPress Theme",
  "image": "php:8.2-cli",
  "runArgs": ["--name", "restaurant-wordpress-theme"],

  
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Named volume that only survives the Claude Code auth/settings folder,
  // while the rest of the home directory is discarded on each rebuild.
  // This keeps you logged in without making the entire container state persistent.
  // ${devcontainerId} ensures each project gets its own volume instead of sharing one.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        // Claude Code extension – provides its own embedded CLI copy
        // for the chat panel, no separate CLI feature is needed (see above).
        "anthropic.claude-code",

        // PHP language server: autocompletion, diagnostics, go-to-definition –
        // a basic requirement for writing PHP meaningfully.
        "bmewburn.vscode-intelephense-client",

        // Coding standards check (configurable for WordPress coding standards) –
        // relevant from the start because you will write security-critical form code
        // yourself and want consistency from day one.
        "wongjn.php-sniffer",

        // Autocompletion for add_action/add_filter, including core hooks –
        // immediately useful once you register hooks in functions.php/inc/*.php.
        "johnbillion.vscode-wordpress-hooks",

        // Consistent formatting rules across all file types (indentation,
        // line endings) – costs nothing and prevents diff noise from the start,
        // especially relevant if the theme is later forked as the basis for more
        // client projects.
        "editorconfig.editorconfig",

        // Git history/blame directly in the editor – useful once the first
        // security-relevant code (form handlers) exists and changes need to remain traceable.
        "eamodio.gitlens"

        // Intentionally not included yet; this can be added later when relevant:
        // - cweijan.vscode-mysql-client2   (once the form DB table exists)
        // - deque-systems.vscode-axe-linter (once patterns/HTML are being worked on)
        // - ms-azuretools.vscode-docker     (once a Nextcloud portal is in scope)
        // - esbenp.vscode-prettier          (once custom JS for form validation exists)
        // - mikestead.dotenv                (once secrets are managed via .env)
        // - humao.rest-client               (once the form endpoint is testable)
      ],

      "settings": {
        "php.suggest.basic": false,
        "editor.formatOnSave": false
      }
    }
  },

  // Optional: lokaler PHP-Dev-Server, falls ihr direkt im Container testen wollt.
  "forwardPorts": [8080],

  "remoteUser": "root"
}
